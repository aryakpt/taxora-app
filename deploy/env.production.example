# Production secrets for the deploy commands (make prod, make prod-migrate, make deploy-env, make deploy).
# Copy to deploy/.env.production (git-ignored) and fill it in. Never commit it, never paste it in a chat.

# Supabase → Project Settings → API (Project URL) and → API Keys (a "secret" key, sb_secret_...).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=
# Supabase → Connect → "Session pooler" connection string, exactly as shown (keep [YOUR-PASSWORD] in it),
# and the database password separately. Special characters in the password are handled for you.
SUPABASE_DB_POOLER_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=

# Gemini API key from a Google Cloud project used only for production (its own free quota).
LLM_API_KEY=
# Optional: "Sign in with Google" OAuth client ID (no secret). Empty hides the button.
GOOGLE_CLIENT_ID=

# The site's address on Vercel, e.g. https://taxora.vercel.app (frontend and API share it)
FRONTEND_ORIGIN=https://taxora.vercel.app

# Vercel → Account Settings → Tokens; the project name becomes https://<name>.vercel.app when it is free.
VERCEL_TOKEN=
VERCEL_PROJECT=taxora
