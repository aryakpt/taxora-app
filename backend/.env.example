APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://taxora:taxora@localhost:5432/taxora
AUTH_SECRET_KEY=generate-with-openssl-rand-hex-32
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=taxora_session
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_MINUTES=60
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=10
AUTH_REGISTRATIONS_PER_HOUR=5
# OAuth client ID (type "Web application") from Google Cloud Console; empty hides "Sign in with Google".
GOOGLE_CLIENT_ID=
# LLM (OpenAI-compatible API). Get a free key at https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=baidu/ernie-5.5-flash-preview:free
# JSON list; a retry starts at the next model and OpenRouter skips unavailable ones automatically.
LLM_FALLBACK_MODELS=["recursive/flint-v1.0:free","dots-studio/dots-3-note-preview:free"]
# zero_retention (no free models qualify) | no_training | any
LLM_DATA_POLICY=no_training
LLM_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=60
LLM_REASONING_EFFORT=low
# Local embeddings (downloaded on first use). Changing the model requires re-indexing.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_COSINE_DISTANCE=0.7
RETRIEVAL_KEYWORD_WEIGHT=0.1
SCOPE_MIN_SIMILARITY=0.33
CHAT_REQUESTS_PER_HOUR=20
# true: tax questions without a matching regulation get a labelled general-knowledge answer; false: refused.
CHAT_ALLOW_GENERAL_ANSWERS=true
MAX_UPLOAD_BYTES=10485760
FRONTEND_ORIGIN=http://localhost:5173
